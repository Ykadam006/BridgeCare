NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Marketing footer mailto (optional)
# NEXT_PUBLIC_CONTACT_EMAIL=team@yourdomain.com

# Optional Leaflet XYZ tiles for the care-options map ({s} subdomain, {z}/{x}/{y}/{r} placeholders)
# NEXT_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# HTML attribution string for the map control (required if you use a custom tile URL in production)
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=Tiles &copy; Esri

# Optional: OSRM-compatible routing API for “full route” lines on the care map (default: public OSRM demo — fair use / not for heavy production traffic)
# NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org
# Profile: driving | foot | bike (depends on server)
# NEXT_PUBLIC_OSRM_PROFILE=driving
